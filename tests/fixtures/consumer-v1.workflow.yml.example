name: Temporary Minuta consumer v1
on:
  push:
    branches: [qa/minuta-consumer-20261115]
permissions:
  contents: read
concurrency:
  group: minuta-consumer-${{ github.ref }}
  cancel-in-progress: false
jobs:
  consumer:
    if: github.ref == 'refs/heads/qa/minuta-consumer-20261115'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Define owned proof path
        shell: bash
        run: echo "MINUTA_OUTPUT=$RUNNER_TEMP/minuta-consumer-proof-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >> "$GITHUB_ENV"
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          persist-credentials: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: '24.22.2'
      - name: Exact-source consumer build and native qualification
        run: python3 tests/scripts/consumer-v1-qa.py
      - name: Retain original bounded bytes in log
        if: always()
        run: node tests/scripts/emit-consumer-proof.mjs
      - name: Retain original consumer receipt
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: minuta-consumer-proof
          path: ${{ env.MINUTA_OUTPUT }}
          retention-days: 7
